      "project": [".opencode/skills"],
      "user": [".config/opencode/skills"],
      "detect": {
        "dirs": [".config/opencode"],
        "commands": ["opencode"],
        "project": [".opencode"]
      },
      "notes": "Also reads .agents/skills and .claude/skills.",
      "instructions": {}
    },
    {
      "id": "qwen",
